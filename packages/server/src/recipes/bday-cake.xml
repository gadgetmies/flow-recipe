<?xml version="1.0" encoding="utf-8" ?>
<recipe ref="https://www.wearesovegan.com/epic-microwave-chocolate-cake/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="recipe.xsd" version="2" id="bday-cake">
    <title>Birthday cake</title>
    <serving temperature="ambient"/>
    <ingredients>
        <ingredient id="oat-milk">oat milk<properties><property name="storage" value="fridge"/></properties></ingredient>
        <ingredient id="white-chocolate-spread">white chocolate spread</ingredient>
        <ingredient id="instant-coffee">instant coffee</ingredient>
        <ingredient id="flour">flour</ingredient>
        <ingredient id="baking-powder">baking powder</ingredient>
        <ingredient id="caster-sugar">caster sugar</ingredient>
        <ingredient id="vegan-cream">vegan cream<properties><property name="storage" value="fridge"/></properties></ingredient>
        <ingredient id="vegan-yoghurt">vegan yoghurt<properties><property name="storage" value="fridge"/></properties></ingredient>
        <ingredient id="margarine">margarine<properties><property name="storage" value="fridge"/><property name="out-of-storage"><numeric-value number="120" unit="minutes"/></property></properties></ingredient>
        <ingredient id="cucumber">cucumber</ingredient>
        <ingredient id="cream-of-tartar">cream of tartar</ingredient>
        <ingredient id="salt">salt</ingredient>
        <ingredient id="raspberries">raspberries<properties><property name="storage" value="fridge"/></properties></ingredient>
        <ingredient id="ground-coriander">ground coriander</ingredient>
        <ingredient id="gin">gin</ingredient>
        <ingredient id="xanthan">xanthan</ingredient>
        <ingredient id="lime">lime</ingredient>
    </ingredients>
    <tools>
        <tool id="silicone-cake-mould" type="cake-mould">silicone cake mould<properties>
                <property name="circumference">
                    <numeric-value number="20" unit="centimeters"/>
                </property>
                <property name="capacity">
                    <numeric-value number="1" unit="cake"/>
                </property>
            </properties>
        </tool>
        <tool id="spatula">spatula</tool>
        <tool id="bowl">bowl<properties>
                <property name="capacity">
                    <numeric-value number="4" unit="l"/>
                </property>
            </properties>
        </tool>
        <tool id="cup">cup<properties>
                <property name="capacity">
                    <numeric-value number="0.3" unit="l"/>
                </property>
            </properties>
        </tool>
        <tool id="whisk">whisk</tool>
        <tool id="frosting-spatula">frosting spatula</tool>
        <tool id="pastry-brush">pastry brush</tool>
        <tool id="precision-scale">precision scale</tool>
        <tool id="kitchen-scale">kitchen scale</tool>
        <tool id="plate">plate</tool>
        <tool id="spoon">spoon</tool>
        <tool id="fork">fork</tool>
        <tool id="serving-plate">serving plate</tool>
        <tool id="fruit-baller">fruit baller</tool>
        <tool id="sieve">sieve</tool>
        <tool id="grater">grater</tool>
    </tools>
    <tasks>
        <task operation="measure" id="measure-oat-milk-for-coffee">
            <options>
                <option name="amount">
                    <numeric-value number="40" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="oat-milk"/>
            </inputs>
            <outputs>
                <output id="oat-milk-for-coffee">oat milk for coffee</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-oat-milk-for-batter">
            <options>
                <option name="amount">
                    <numeric-value number="100" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="oat-milk"/>
            </inputs>
            <outputs>
                <output id="oat-milk-for-batter">oat milk for batter</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-spread-for-filling">
            <options>
                <option name="amount">
                    <numeric-value number="20" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="white-chocolate-spread"/>
            </inputs>
            <outputs>
                <output id="white-chocolate-spread-for-filling">white chocolate for filling</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-spread-for-frosting">
            <options>
                <option name="amount">
                    <numeric-value number="20" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="white-chocolate-spread"/>
            </inputs>
            <outputs>
                <output id="white-chocolate-spread-for-frosting">white chocolate spread for frosting</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-coffee">
            <options>
                <option name="amount">
                    <numeric-value number="8" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true" soil="none"/>
                <tool ref="precision-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="instant-coffee"/>
            </inputs>
            <outputs>
                <output id="measured-instant-coffee">instant coffee</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-margarine">
            <options>
                <option name="amount">
                    <numeric-value number="170" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="bowl" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="margarine"/>
            </inputs>
            <outputs>
                <output id="measured-margarine">margarine</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-margarine-for-greasing">
            <options>
                <option name="amount">
                    <numeric-value number="20" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="margarine"/>
            </inputs>
            <outputs>
                <output id="margarine-for-greasing">margarine</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-flour">
            <options>
                <option name="amount">
                    <numeric-value number="220" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="bowl" reserved="true" soil="none"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="flour"/>
            </inputs>
            <outputs>
                <output id="measured-flour">flour</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-sugar">
            <options>
                <option name="amount">
                    <numeric-value number="100" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true" soil="none"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="caster-sugar"/>
            </inputs>
            <outputs>
                <output id="measured-caster-sugar">caster sugar</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-cream-for-frosting">
            <options>
                <option name="amount">
                    <numeric-value number="100" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="vegan-cream"/>
            </inputs>
            <outputs>
                <output id="vegan-cream-for-frosting">vegan cream</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-cream-of-tartar">
            <options>
                <option name="amount">
                    <numeric-value number="1" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true" soil="none"/>
                <tool ref="precision-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="cream-of-tartar"/>
            </inputs>
            <outputs>
                <output id="measured-cream-of-tartar">cream of tartar</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-coriander">
            <options>
                <option name="amount">
                    <numeric-value number="4" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true" soil="none"/>
                <tool ref="precision-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="ground-coriander"/>
            </inputs>
            <outputs>
                <output id="measured-ground-coriander">coriander</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-salt">
            <options>
                <option name="amount">
                    <numeric-value number="4" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true" soil="none"/>
                <tool ref="precision-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="salt"/>
            </inputs>
            <outputs>
                <output id="salt-for-batter">salt for batter</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-xanthan">
            <options>
                <option name="amount">
                    <numeric-value number="4" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true" soil="none"/>
                <tool ref="precision-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="xanthan"/>
            </inputs>
            <outputs>
                <output id="measured-xanthan">xanthan</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-baking-powder">
            <options>
                <option name="amount">
                    <numeric-value number="4" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true" soil="none"/>
                <tool ref="precision-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="baking-powder"/>
            </inputs>
            <outputs>
                <output id="measured-baking-powder">baking powder</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-cucumber-for-filling">
            <options>
                <option name="amount">
                    <numeric-value number="200" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="plate" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="cucumber"/>
            </inputs>
            <outputs>
                <output id="measured-cucumber">cucumber for filling</output>
            </outputs>
        </task>

        <task operation="soften" id="soften-margarine">
            <instructions>
                Soften the
                <input ref="measured-margarine"/>
                with a
                <tool ref="fork"/>
                in a
                <tool ref="bowl" reserved="true"/>.
            </instructions>
            <outputs>
                <output id="softened-margarine">softened margarine</output>
            </outputs>
        </task>

        <task operation="cream" id="cream-margarine-and-sugar">
            <instructions>
                Whip the
                <input ref="softened-margarine"/>
                with
                <input ref="measured-caster-sugar"/>
                using a
                <tool ref="whisk"/>
                until light and fluffy.
            </instructions>
            <tools>
                <tool ref="bowl" reserved="true"/>
            </tools>
            <outputs>
                <output id="creamed-margarine-and-sugar">creamed margarine and sugar</output>
            </outputs>
        </task>

        <task operation="heat" id="heat-oat-milk">
            <options>
                <option name="temperature">
                    <numeric-value number="60" unit="celsius"/>
                </option>
                <option name="duration">
                    <numeric-value number="30" unit="seconds"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
            </tools>
            <inputs>
                <input ref="oat-milk-for-coffee"/>
            </inputs>
            <outputs>
                <output id="heated-oat-milk" hold="10" hold-unit="minutes">heated oat milk</output>
            </outputs>
            <instructions>
                Heat the <input ref="oat-milk-for-coffee"/> in the microwave.
            </instructions>
        </task>

        <task operation="mix" id="make-oat-milk-coffee">
            <instructions>
                Add the
                <input ref="measured-instant-coffee"/>
                to
                <input ref="heated-oat-milk"/>
                and stir with a
                <tool ref="spoon"/>.
            </instructions>
            <tools>
                <tool ref="cup" reserved="true"/>
            </tools>
            <outputs>
                <output id="oat-milk-coffee">oat milk coffee</output>
            </outputs>
        </task>

        <task operation="mix" id="mix-dry-ingredients">
            <instructions>
                Add the
                <input ref="measured-flour"/>,
                <input ref="measured-baking-powder"/>,
                <input ref="salt-for-batter"/>,
                <input ref="measured-xanthan"/>
                and
                <input ref="measured-ground-coriander"/>
                to a
                <tool ref="bowl" reserved="true" soil="none"/>
                and stir with a
                <tool ref="spatula" reserved="true" soil="none"/>.
            </instructions>
            <outputs>
                <output id="dry-ingredients">dry ingredients</output>
            </outputs>
        </task>
        <task operation="mix" id="mix-dry-into-creamed">
            <instructions>
                Mix the
                <input ref="dry-ingredients"/>
                into the
                <input ref="creamed-margarine-and-sugar"/>.
            </instructions>
            <tools>
                <tool ref="bowl" reserved="true"/>
                <tool ref="spatula" reserved="true"/>
            </tools>
            <outputs>
                <output id="butter-sugar-dry-ingredient-mix">butter, sugar and dry ingredients mix</output>
            </outputs>
        </task>
        <task operation="mix" id="mix-batter">
            <instructions>
                First, add the
                <input ref="oat-milk-for-batter"/>
                into the
                <input ref="butter-sugar-dry-ingredient-mix"/>
                and stir with a
                <tool ref="spatula" reserved="true"/>
                until smooth. Then add the
                <input ref="oat-milk-coffee"/>
                and, again, mix until smooth.
            </instructions>
            <tools>
                <tool ref="bowl" reserved="true"/>
            </tools>
            <outputs>
                <output id="batter" volume="1" volume-unit="l">batter</output>
                <tool ref="bowl" name="dry ingredients bowl"/>
            </outputs>
        </task>

        <task operation="grease" id="prepare-mould">
            <instructions>
                Grease the sides of a
                <tool ref="silicone-cake-mould" reserved="true"/>
                with
                <input ref="margarine-for-greasing"/>.
            </instructions>
            <outputs>
                <output id="prepared-cake-mould" amount="1" unit="cake">prepared cake mould</output>
            </outputs>
        </task>
        <task operation="split" id="split-batter">
            <options>
                <option name="parts">
                    <numeric-value number="2"/>
                </option>
            </options>
            <inputs>
                <input ref="batter"/>
            </inputs>
            <tools>
                <tool ref="bowl" reserved="true"/>
            </tools>
            <outputs>
                <output id="split-batter-in-a-bowl" amount="2" unit="cake">split batter</output>
            </outputs>
        </task>
        <task operation="pour" id="pour-into-mould">
            <instructions>
                Pour the
                <input ref="split-batter-in-a-bowl"/>
                into the
                <input ref="prepared-cake-mould">cake mould</input>
            </instructions>
            <tools>
                <tool ref="silicone-cake-mould" reserved="true"/>
            </tools>
            <outputs>
                <output id="batter-in-mould" amount="2" unit="cake">cake mould with batter</output>
                <tool ref="bowl" name="used bowl"/>
                <tool ref="spatula"/>
            </outputs>
        </task>
        <task operation="bake-in-microwave" id="bake">
            <instructions>
                Bake the
                <input ref="batter-in-mould"/>
                in the microwave with
                <option name="power">
                    <numeric-value number="700" unit="watts"/>
                </option>
                for
                <option name="duration">
                    <numeric-value number="4" unit="minutes"/>
                </option>
                or until a toothpick comes out clean.
            </instructions>
            <outputs>
                <output id="baked-cake" amount="2" unit="cake">baked cake</output>
            </outputs>
        </task>
        <task operation="chill" id="cool-in-mould">
            <instructions>
                Cool the
                <input ref="baked-cake"/>
                for
                <option name="duration">
                    <numeric-value number="10" unit="minutes"/>
                </option>
                in the <tool ref="silicone-cake-mould" reserved="true">mould</tool>.
            </instructions>
            <outputs>
                <output id="cooled-cake-in-mould" amount="2" unit="cake">cooled cake in mould</output>
            </outputs>
        </task>
        <task operation="separate" id="turn-out">
            <instructions>
                Detach the
                <input ref="cooled-cake-in-mould">cooled cake</input>
                from the mould by running a
                <tool ref="spatula"/>
                around the edges. Turn out the cake from the mould onto a
                <tool ref="serving-plate" reserved="true"/>.
            </instructions>
            <outputs>
                <output id="cake-on-a-plate" amount="2" unit="cake">cake on a plate</output>
                <tool ref="silicone-cake-mould" name="used cake mould"/>
            </outputs>
        </task>

        <task operation="grate" id="grate-cucumber">
            <instructions>
                Grate the
                <input ref="measured-cucumber"/>
                with a
                <tool ref="grater"/>
                into a
                <tool ref="sieve" reserved="true"/>
                on top of a
                <tool ref="bowl" reserved="true"/>.
                Press the grated cucumber to push out the liquid.
            </instructions>
            <outputs>
                <output id="grated-cucumber" hold="60" hold-unit="minutes">grated cucumber</output>
                <output id="cucumber-juice">cucumber juice</output>
                <tool ref="plate"/>
            </outputs>
        </task>

        <task operation="measure" id="measure-yoghurt">
            <options>
                <option name="amount">
                    <numeric-value number="40" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="vegan-yoghurt"/>
            </inputs>
            <outputs>
                <output id="measured-vegan-yoghurt">yoghurt for filling</output>
            </outputs>
        </task>

        <task operation="mix" id="mix-filling">
            <instructions>
                Mix the
                <input ref="grated-cucumber"/>,
                <input ref="measured-vegan-yoghurt"/>
                and
                <input ref="white-chocolate-spread-for-filling"/>
                in a
                <tool ref="bowl" reserved="true" soil="wash"/>
                with a
                <tool ref="spoon" soil="wash"/>.
            </instructions>
            <outputs>
                <output id="filling" hold="60" hold-unit="minutes">filling</output>
                <tool ref="sieve"/>
            </outputs>
        </task>

        <task operation="measure" id="measure-cucumber-juice">
            <options>
                <option name="amount">
                    <numeric-value number="40" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="cucumber-juice"/>
            </inputs>
            <outputs>
                <output id="measured-cucumber-juice">cucumber juice for filling</output>
                <tool ref="bowl" name="juice bowl"/>
            </outputs>
        </task>

        <task operation="measure" id="measure-gin">
            <options>
                <option name="amount">
                    <numeric-value number="20" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="cup" reserved="true"/>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="gin"/>
            </inputs>
            <outputs>
                <output id="measured-gin">gin</output>
            </outputs>
        </task>

        <task operation="mix" id="mix-cucumber-gin">
            <instructions>
                Add the
                <input ref="measured-gin"/>
                to the
                <input ref="measured-cucumber-juice"/>
            </instructions>
            <tools>
                <tool ref="cup" reserved="true"/>
            </tools>
            <outputs>
                <output id="cucumber-gin-mix">cucumber gin mix</output>
            </outputs>
        </task>
        <task operation="spread" id="fill-cake">
            <instructions>
                Brush the
                <input ref="cake-on-a-plate">cake</input>
                lightly with the
                <input ref="cucumber-gin-mix"/>
                using a
                <tool ref="pastry-brush"/>.
                Spread the
                <input ref="filling"/>
                over the top with a
                <tool ref="spatula"/>
                and place the second cake on top of the filling. Brush also the top of the cake.
            </instructions>
            <tools>
                <tool ref="serving-plate" reserved="true"/>
            </tools>
            <outputs>
                <output id="filled-cake" amount="1" unit="cake">filled cake</output>
                <tool ref="spatula"/>
                <tool ref="bowl" name="filling bowl"/>
            </outputs>
        </task>
        <task operation="mix" id="mix-cream-and-tartar">
            <instructions>
                Add
                <input ref="vegan-cream-for-frosting"/>
                and
                <input ref="measured-cream-of-tartar"/>
                into a
                <tool ref="bowl" reserved="true" soil="wash"/>
            </instructions>
            <outputs>
                <output id="cream-tartar-mix">cream tartar mix</output>
            </outputs>
        </task>
        <task operation="whip" id="whip-cream">
            <instructions>
                Whip the
                <input ref="cream-tartar-mix"/>
                using a
                <tool ref="whisk" soil="wash"/>
                until soft peaks form.
            </instructions>
            <tools>
                <tool ref="bowl" reserved="true" soil="wash"/>
            </tools>
            <outputs>
                <output id="softly-whisked-cream" hold="30" hold-unit="minutes">softly whipped cream</output>
            </outputs>
        </task>
        <task operation="mix" id="mix-spread-into-cream">
            <instructions>
                Add
                <input ref="white-chocolate-spread-for-frosting"/>
                to the
                <input ref="softly-whisked-cream"/>.
            </instructions>
            <tools>
                <tool ref="bowl" reserved="true" soil="wash"/>
            </tools>
            <outputs>
                <output id="white-chocolate-cream-mix" hold="30" hold-unit="minutes">white chocolate cream mix</output>
            </outputs>
        </task>
        <task operation="whip" id="whip-frosting">
            <instructions>
                Whip the
                <input ref="white-chocolate-cream-mix"/>
                until hard peaks form using a
                <tool ref="whisk" soil="wash"/>.
            </instructions>
            <tools>
                <tool ref="bowl" reserved="true" soil="wash"/>
            </tools>
            <outputs>
                <output id="frosting" hold="30" hold-unit="minutes">frosting</output>
            </outputs>
        </task>
        <task operation="spread" id="frost-cake">
            <instructions>
                Add the
                <input ref="frosting"/>
                on top of the center of the
                <input ref="filled-cake">cake</input>
                and use a
                <tool ref="frosting-spatula" soil="wash"/>
                to ease it around the sides.
            </instructions>
            <tools>
                <tool ref="serving-plate" reserved="true"/>
            </tools>
            <outputs>
                <output id="frosted-cake" amount="1" unit="cake">frosted cake</output>
                <tool ref="bowl" name="frosting bowl"/>
            </outputs>
        </task>

        <task operation="measure" id="measure-cucumber-for-decoration">
            <options>
                <option name="amount">
                    <numeric-value number="10" unit="cm"/>
                </option>
            </options>
            <inputs>
                <input ref="cucumber"/>
            </inputs>
            <tools>
                <tool ref="plate" reserved="true"/>
            </tools>
            <outputs>
                <output id="cucumber-for-decorations">cucumber for decorations</output>
            </outputs>
        </task>
        <task operation="ball" id="ball-cucumber">
            <instructions>
                Use a
                <tool ref="fruit-baller"/>
                to make balls from the
                <input ref="cucumber-for-decorations"/>
            </instructions>
            <tools>
                <tool ref="plate" reserved="true"/>
            </tools>
            <outputs>
                <output id="cucumber-balls" hold="60" hold-unit="minutes">cucumber balls</output>
            </outputs>
        </task>

        <task operation="decorate" id="decorate-cake">
            <instructions>
                Place the
                <input ref="cucumber-balls"/>
                and
                <input ref="raspberries"/>
                on top of the
                <input ref="frosted-cake"/>.
            </instructions>
            <tools>
                <tool ref="serving-plate" reserved="true"/>
            </tools>
            <outputs>
                <output id="decorated-cake" amount="1" unit="cake">decorated cake</output>
                <tool ref="plate"/>
            </outputs>
        </task>

        <task operation="grate" id="grate-lime">
            <inputs>
                <input ref="lime"/>
            </inputs>
            <tools>
                <tool ref="grater"/>
                <tool ref="cup" reserved="true"/>
            </tools>
            <outputs>
                <output id="lime-curls">lime zest</output>
            </outputs>
        </task>

        <task operation="sprinkle" id="sprinkle-lime">
            <instructions>
                Sprinkle the
                <input ref="lime-curls"/>
                on top of the
                <input ref="decorated-cake">cake</input>
            </instructions>
            <tools>
                <tool ref="serving-plate" reserved="true"/>
            </tools>
            <outputs>
                <output id="finished-cake" amount="1" unit="cake" final="true">birthday cake</output>
            </outputs>
        </task>
    </tasks>
</recipe>
