<?xml version="1.0" encoding="utf-8" ?>
<recipe xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="recipe.xsd"
        version="2" id="buns">
    <title>Buns</title>
    <serving temperature="hot" hold="10" hold-unit="minutes"/>
    <ingredients>
        <ingredient id="milk">milk<properties>
                <property name="storage" value="fridge"/>
                <property name="fat-content">
                    <numeric-value number="3" unit="percent"/>
                </property>
            </properties>
        </ingredient>
        <ingredient id="yeast">yeast<properties>
                <property name="storage" value="fridge"/>
                <property name="type" value="dry"/>
            </properties>
        </ingredient>
        <ingredient id="egg">egg<properties>
                <property name="storage" value="fridge"/>
                <property name="size" value="medium"/>
            </properties>
        </ingredient>
        <ingredient id="salt">salt<properties>
                <property name="type" value="fine"/>
            </properties>
        </ingredient>
        <ingredient id="sugar">sugar<properties>
                <property name="type" value="white"/>
            </properties>
        </ingredient>
        <ingredient id="pearl-sugar">sugar<properties>
                <property name="type" value="pearl"/>
            </properties>
        </ingredient>
        <ingredient id="cardamom">cardamom<properties>
                <property name="type" value="ground"/>
            </properties>
        </ingredient>
        <ingredient id="flour">white bread flour</ingredient>
        <ingredient id="butter">butter<properties>
                <property name="storage" value="fridge"/>
                <property name="out-of-storage"><numeric-value number="120" unit="minutes"/></property>
                <property name="salt-content">
                    <numeric-value number="11" unit="milligram"/>
                </property>
            </properties>
        </ingredient>
    </ingredients>
    <tools>
        <!-- The dough is about 2.5 l and doubles while raising, so it needs the big bowl. -->
        <tool id="large-bowl">large bowl<properties>
                <property name="capacity">
                    <numeric-value number="8" unit="l"/>
                </property>
            </properties>
        </tool>
        <tool id="bowl">bowl<properties>
                <property name="capacity">
                    <numeric-value number="4" unit="l"/>
                </property>
            </properties>
        </tool>
        <tool id="kitchen-scale">kitchen scale</tool>
        <tool id="fork">fork</tool>
        <tool id="towel">towel</tool>
        <tool id="baking-sheet">baking sheet<properties>
                <property name="capacity">
                    <numeric-value number="16" unit="bun"/>
                </property>
            </properties>
        </tool>
        <tool id="parchment-paper">parchment paper</tool>
        <tool id="pastry-brush">pastry brush</tool>
        <tool id="cooling-rack">cooling rack<properties>
                <property name="capacity">
                    <numeric-value number="32" unit="bun"/>
                </property>
            </properties>
        </tool>
    </tools>
    <tasks>
        <task operation="measure" id="measure-milk">
            <options>
                <option name="amount">
                    <numeric-value number="0.5" unit="l"/>
                </option>
            </options>
            <tools>
                <tool ref="large-bowl" reserved="true"/>
            </tools>
            <inputs>
                <input ref="milk"/>
            </inputs>
            <outputs>
                <output id="milk-for-dough">milk</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-yeast">
            <options>
                <option name="amount">
                    <numeric-value number="50" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="yeast"/>
            </inputs>
            <outputs>
                <output id="yeast-for-dough">yeast</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-sugar">
            <options>
                <option name="amount">
                    <numeric-value number="100" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="sugar"/>
            </inputs>
            <outputs>
                <output id="sugar-for-dough">sugar</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-cardamom">
            <options>
                <option name="amount">
                    <numeric-value number="10" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="cardamom"/>
            </inputs>
            <outputs>
                <output id="cardamom-for-dough">cardamom</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-eggs-for-dough">
            <options>
                <option name="amount">
                    <numeric-value number="2" unit="pieces"/>
                </option>
            </options>
            <inputs>
                <input ref="egg"/>
            </inputs>
            <outputs>
                <output id="eggs-for-dough">eggs</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-flour">
            <options>
                <option name="amount">
                    <numeric-value number="900" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="flour"/>
            </inputs>
            <outputs>
                <output id="flour-for-dough">flour</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-butter">
            <options>
                <option name="amount">
                    <numeric-value number="200" unit="g"/>
                </option>
            </options>
            <tools>
                <tool ref="kitchen-scale" soil="none"/>
            </tools>
            <inputs>
                <input ref="butter"/>
            </inputs>
            <outputs>
                <output id="butter-for-dough">butter</output>
            </outputs>
        </task>
        <task operation="heat" id="heat-milk">
            <options>
                <option name="temperature">
                    <numeric-value number="30" unit="celsius"/>
                </option>
            </options>
            <tools>
                <tool ref="large-bowl" reserved="true"/>
            </tools>
            <inputs>
                <input ref="milk-for-dough"/>
            </inputs>
            <outputs>
                <output id="warm-milk" hold="10" hold-unit="minutes">warm milk</output>
            </outputs>
            <instructions>
                Heat the <input ref="milk-for-dough"/> in the microwave to hand warm.
            </instructions>
        </task>
        <join id="dissolve-yeast">
            <task operation="crumble" id="crumble-yeast">
                <inputs>
                    <input ref="yeast-for-dough"/>
                </inputs>
                <outputs>
                    <output id="crumbled-yeast">crumbled yeast</output>
                </outputs>
            </task>
            <task operation="incorporate" id="stir-yeast-into-milk">
                <tools>
                    <tool ref="large-bowl" reserved="true"/>
                </tools>
                <inputs>
                    <input ref="warm-milk"/>
                    <input ref="crumbled-yeast"/>
                </inputs>
                <outputs>
                    <output id="milk-and-yeast">milk and yeast</output>
                </outputs>
            </task>
        </join>
        <task operation="incorporate" id="mix-wet-ingredients">
            <tools>
                <tool ref="large-bowl" reserved="true" soil="wash"/>
            </tools>
            <inputs>
                <input ref="milk-and-yeast"/>
                <input ref="eggs-for-dough"/>
                <input ref="sugar-for-dough"/>
                <input ref="cardamom-for-dough"/>
            </inputs>
            <outputs>
                <output id="wet-mix">wet mix</output>
            </outputs>
        </task>
        <task operation="mix-in-steps" id="mix-in-flour">
            <tools>
                <tool ref="large-bowl" reserved="true"/>
            </tools>
            <inputs>
                <input ref="wet-mix"/>
                <input ref="flour-for-dough"/>
            </inputs>
            <outputs>
                <output id="dough-without-butter">dough</output>
            </outputs>
            <instructions>
                Add the <input ref="flour-for-dough"/> to the <input ref="wet-mix"/> about a deciliter at a time,
                mixing until the dough comes together.
            </instructions>
        </task>
        <task operation="incorporate" id="knead-in-butter">
            <tools>
                <tool ref="large-bowl" reserved="true"/>
            </tools>
            <inputs>
                <input ref="dough-without-butter"/>
                <input ref="butter-for-dough"/>
            </inputs>
            <outputs>
                <output id="dough" volume="2.5" volume-unit="l">dough</output>
            </outputs>
        </task>
        <task operation="raise" id="raise-dough">
            <options>
                <option name="duration">
                    <numeric-value number="20" unit="minutes"/>
                </option>
            </options>
            <tools>
                <tool ref="large-bowl" reserved="true"/>
                <tool ref="towel" reserved="true" soil="none"/>
            </tools>
            <inputs>
                <input ref="dough"/>
            </inputs>
            <outputs>
                <output id="raised-dough" hold="15" hold-unit="minutes" volume="5" volume-unit="l">raised dough</output>
            </outputs>
            <instructions>
                Cover the <input ref="dough"/> with a <tool ref="towel" reserved="true" soil="none"/> and let it raise
                in a warm place until doubled in size.
            </instructions>
        </task>
        <task operation="measure" id="measure-egg-for-brushing">
            <options>
                <option name="amount">
                    <numeric-value number="1" unit="pieces"/>
                </option>
            </options>
            <inputs>
                <input ref="egg"/>
            </inputs>
            <outputs>
                <output id="egg-for-brushing">egg</output>
            </outputs>
        </task>
        <task operation="beat" id="beat-egg">
            <tools>
                <tool ref="bowl" reserved="true" soil="wash"/>
                <tool ref="fork" soil="wash"/>
            </tools>
            <inputs>
                <input ref="egg-for-brushing"/>
            </inputs>
            <outputs>
                <output id="beaten-egg" hold="60" hold-unit="minutes">beaten egg</output>
            </outputs>
        </task>
        <task operation="line" id="line-sheets">
            <!-- One task for all sheets; the sheet count (4 at scale 1) does not follow the scale automatically. -->
            <inputs>
                <input ref="parchment-paper"/>
            </inputs>
            <tools>
                <tool ref="baking-sheet" reserved="true"/>
            </tools>
            <outputs>
                <output id="lined-baking-sheet" amount="4" unit="sheet">lined baking sheet</output>
            </outputs>
            <instructions>
                Line the <tool ref="baking-sheet" reserved="true"/> with <input ref="parchment-paper"/>.
            </instructions>
        </task>
        <task operation="split" id="split-dough">
            <options>
                <option name="unit-size">
                    <numeric-value number="30" unit="g"/>
                </option>
            </options>
            <inputs>
                <input ref="raised-dough"/>
            </inputs>
            <outputs>
                <output id="bun-dough" amount="64" unit="bun">dough for one bun</output>
                <tool ref="large-bowl"/>
                <tool ref="towel"/>
            </outputs>
        </task>
        <task operation="spherify" id="roll-buns">
            <inputs>
                <input ref="bun-dough"/>
            </inputs>
            <outputs>
                <output id="dough-ball" amount="64" unit="bun">dough ball</output>
            </outputs>
            <instructions>
                Roll each <input ref="bun-dough"/> into a smooth ball between your palms.
            </instructions>
        </task>
        <task operation="place-on-sheet" id="place-on-sheet">
            <tools>
                <tool ref="baking-sheet" reserved="true"/>
            </tools>
            <inputs>
                <input ref="dough-ball"/>
                <input ref="lined-baking-sheet"/>
            </inputs>
            <outputs>
                <output id="bun-on-sheet" amount="64" unit="bun">bun on sheet</output>
            </outputs>
        </task>
        <task operation="brush" id="brush-buns">
            <tools>
                <tool ref="pastry-brush" soil="wash"/>
            </tools>
            <inputs>
                <input ref="bun-on-sheet"/>
                <input ref="beaten-egg"/>
            </inputs>
            <outputs>
                <output id="brushed-bun" amount="64" unit="bun">brushed bun</output>
            </outputs>
        </task>
        <task operation="sprinkle" id="sprinkle-pearl-sugar">
            <inputs>
                <input ref="brushed-bun"/>
                <input ref="pearl-sugar"/>
            </inputs>
            <outputs>
                <output id="oven-ready-bun" amount="64" unit="bun" hold="30" hold-unit="minutes">oven ready bun</output>
            </outputs>
        </task>
        <task operation="bake-in-oven" id="bake-buns" requires="oven">
            <options>
                <option name="temperature">
                    <numeric-value number="225" unit="celsius"/>
                </option>
                <option name="duration">
                    <numeric-value number="15" unit="minutes"/>
                </option>
            </options>
            <tools>
                <!-- the sheet goes into the oven with the buns: this is what makes the oven rounds derivable -->
                <tool ref="baking-sheet" reserved="true" soil="none"/>
            </tools>
            <inputs>
                <input ref="oven-ready-bun"/>
            </inputs>
            <outputs>
                <output id="baked-bun" amount="64" unit="bun" hold="10" hold-unit="minutes">baked bun</output>
            </outputs>
        </task>
        <task operation="transfer" id="transfer-to-rack">
            <tools>
                <tool ref="cooling-rack" reserved="true" soil="none"/>
            </tools>
            <inputs>
                <input ref="baked-bun"/>
            </inputs>
            <outputs>
                <output id="finished-buns" amount="64" unit="bun" hold="10" hold-unit="minutes" final="true">buns</output>
                <tool ref="baking-sheet"/>
            </outputs>
            <instructions>
                Move the <input ref="baked-bun"/> from the sheet onto a <tool ref="cooling-rack" reserved="true" soil="none"/>.
            </instructions>
        </task>
    </tasks>
</recipe>
