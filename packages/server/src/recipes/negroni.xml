<?xml version="1.0" encoding="utf-8" ?>
<recipe xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="recipe.xsd"
        ref="https://www.tentoonerum.com/cocktails/negroni/" version="2" id="negroni">
    <title>Rum Negroni</title>
    <serving temperature="cold" hold="5" hold-unit="minutes"/>
    <ingredients>
        <ingredient id="rum">white or dark rum</ingredient>
        <ingredient id="campari">Campari</ingredient>
        <ingredient id="sweet-vermouth">sweet Vermouth<properties><property name="storage" value="fridge"/></properties></ingredient>
        <ingredient id="orange-bitters">orange bitters</ingredient>
        <ingredient id="ice-cubes">ice cubes<properties><property name="storage" value="freezer"/><property name="out-of-storage"><numeric-value number="5" unit="minutes"/></property></properties></ingredient>
        <ingredient id="orange">orange</ingredient>
        <ingredient id="large-ice-cube">large ice cube<properties><property name="storage" value="freezer"/><property name="out-of-storage"><numeric-value number="5" unit="minutes"/></property></properties></ingredient>
    </ingredients>
    <tools>
        <tool id="mixing-glass">mixing glass<properties>
                <property name="capacity">
                    <numeric-value number="2" unit="drink"/>
                </property>
            </properties>
        </tool>
        <tool id="bar-spoon">bar spoon</tool>
        <tool id="strainer">strainer</tool>
        <tool id="rocks-glass">rocks glass<properties>
                <property name="capacity">
                    <numeric-value number="1" unit="drink"/>
                </property>
            </properties>
        </tool>
        <tool id="peeler">peeler</tool>
    </tools>
    <tasks>
        <task operation="fill" id="fill-mixing-glass">
            <instructions>
                Fill the
                <tool ref="mixing-glass" reserved="true"/>
                with
                <input ref="ice-cubes"/>
            </instructions>
            <outputs>
                <output id="filled-mixing-glass" amount="1" unit="drink">mixing glass with ice</output>
            </outputs>
        </task>
        <task operation="peel" id="peel-orange">
            <inputs>
                <input ref="orange"/>
            </inputs>
            <tools>
                <tool ref="peeler"/>
            </tools>
            <outputs>
                <output id="orange-peel" amount="1" unit="drink">strip of orange peel</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-rum">
            <options>
                <option name="amount">
                    <numeric-value number="1" unit="oz"/>
                </option>
            </options>
            <inputs>
                <input ref="rum"/>
            </inputs>
            <outputs>
                <output id="measured-rum">rum</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-campari">
            <options>
                <option name="amount">
                    <numeric-value number="1" unit="oz"/>
                </option>
            </options>
            <inputs>
                <input ref="campari"/>
            </inputs>
            <outputs>
                <output id="measured-campari">Campari</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-vermouth">
            <options>
                <option name="amount">
                    <numeric-value number="1" unit="oz"/>
                </option>
            </options>
            <inputs>
                <input ref="sweet-vermouth"/>
            </inputs>
            <outputs>
                <output id="measured-vermouth">sweet Vermouth</output>
            </outputs>
        </task>
        <task operation="measure" id="measure-bitters">
            <options>
                <option name="amount">
                    <numeric-value number="2" unit="dashes"/>
                </option>
            </options>
            <inputs>
                <input ref="orange-bitters"/>
            </inputs>
            <outputs>
                <output id="measured-bitters">orange bitters</output>
            </outputs>
        </task>
        <task operation="incorporate" id="build-drink">
            <tools>
                <tool ref="mixing-glass" reserved="true"/>
            </tools>
            <inputs>
                <input ref="filled-mixing-glass"/>
                <input ref="measured-rum"/>
                <input ref="measured-campari"/>
                <input ref="measured-vermouth"/>
                <input ref="measured-bitters"/>
            </inputs>
            <outputs>
                <output id="ingredients-in-mixing-glass" amount="1" unit="drink">ingredients in mixing glass</output>
            </outputs>
            <instructions>
                Add the <input ref="measured-rum"/>, <input ref="measured-campari"/>, <input ref="measured-vermouth"/>
                and <input ref="measured-bitters"/> to the <input ref="filled-mixing-glass"/>.
            </instructions>
        </task>
        <task operation="stir" id="stir-drink">
            <tools>
                <tool ref="bar-spoon"/>
                <tool ref="mixing-glass" reserved="true"/>
            </tools>
            <inputs>
                <input ref="ingredients-in-mixing-glass"/>
            </inputs>
            <outputs>
                <output id="stirred-negroni" amount="1" unit="drink" hold="5" hold-unit="minutes">stirred negroni</output>
            </outputs>
        </task>
        <task operation="strain" id="strain-into-glass">
            <instructions>
                Strain
                <input ref="stirred-negroni"/>
                into a
                <tool ref="rocks-glass" reserved="true"/>
                over a
                <input ref="large-ice-cube"/>
                using a
                <tool ref="strainer"/>
            </instructions>
            <outputs>
                <output id="strained-negroni" amount="1" unit="drink">negroni in glass</output>
                <tool ref="mixing-glass"/>
            </outputs>
        </task>
        <task operation="express" id="express-peel">
            <instructions>
                Express oils from the
                <input ref="orange-peel"/>
                over the
                <input ref="strained-negroni"/>
            </instructions>
            <outputs>
                <output id="expressed-negroni" amount="1" unit="drink">negroni with expressed oils</output>
            </outputs>
        </task>
        <task operation="decorate" id="garnish">
            <instructions>
                Garnish the
                <input ref="expressed-negroni"/>
                with the
                <input ref="orange-peel"/>
            </instructions>
            <outputs>
                <output id="finished-negroni" amount="1" unit="drink" hold="5" hold-unit="minutes" final="true">Rum Negroni</output>
            </outputs>
        </task>
    </tasks>
</recipe>
