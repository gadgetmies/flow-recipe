<?xml version="1.0" encoding="UTF-8"?>
<!--
  Operation catalogue, version 2 (operations.xsd). Every attribute is set deliberately; see SCHEDULING.spec.md §3
  and §10.2 for the meaning of each one.

  Time model: the client's `timeline` functions were `K * scale` (per-unit: active 0, per-unit K), `K * sqrt(scale)`
  (sub-linear: active 0, per-unit K) or a constant (fixed). With units = 1 every operation takes the same time as
  before. Passive parts come from the task's options (passive-from) or a constant.
-->
<operations xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="operations.xsd">

    <!-- ===== Preparation ===== -->

    <!-- Generated by the scheduler for mise en place: fetch the listed ingredients from the pantry, fridge or freezer.
         Per-unit = per ingredient. Never written in recipes. -->
    <operation name="gather" min-inputs="0" min-outputs="0" max-outputs="0"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="10"
               soil="none" station="counter" tedium="0.8">
        <title>Gather ingredients</title>
        <timeline model="per-unit" active="30" per-unit="8" passive="0"/>
    </operation>

    <operation name="measure" min-inputs="1" max-inputs="2" min-outputs="1" max-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1.2">
        <title>Measure</title>
        <options>
            <option name="amount" type="numeric" required="true"/>
        </options>
        <timeline model="sub-linear" active="0" per-unit="60" passive="0"/>
    </operation>

    <operation name="crumble" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1">
        <title>Crumble</title>
        <timeline model="per-unit" active="20" per-unit="5" passive="0"/>
    </operation>

    <operation name="separate" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="wash" station="counter" tedium="1">
        <title>Separate</title>
        <timeline model="per-unit" active="60" per-unit="15" passive="0"/>
    </operation>

    <operation name="grate" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="rinse" station="counter" tedium="1.3">
        <title>Grate</title>
        <timeline model="per-unit" active="0" per-unit="120" passive="0"/>
    </operation>

    <operation name="slice" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1" requires="knife">
        <title>Slice</title>
        <options>
            <option name="parts" type="numeric" required="true"/>
        </options>
        <timeline model="sub-linear" active="0" per-unit="60" passive="0"/>
    </operation>

    <operation name="peel" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="units" min-chunk="180" preemptible="units" soil="rinse" station="counter" tedium="1" requires="knife">
        <title>Peel</title>
        <timeline model="per-unit" active="0" per-unit="60" passive="0"/>
    </operation>

    <operation name="split" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="units" min-chunk="180" preemptible="units" soil="rinse" station="counter" tedium="1" expand="split">
        <title>Split</title>
        <options>
            <option name="parts" type="numeric" required="false"/>
            <option name="unit-size" type="numeric" required="false" default-unit="grams"/>
        </options>
        <timeline model="per-unit" active="30" per-unit="3" passive="0"/>
    </operation>

    <!-- ===== Mixing ===== -->

    <operation name="mix" min-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="wash" station="counter" tedium="1">
        <title>Mix</title>
        <timeline model="sub-linear" active="0" per-unit="60" passive="0"/>
    </operation>

    <operation name="incorporate" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="wash" station="counter" tedium="1">
        <title>Mix</title>
        <timeline model="per-unit" active="0" per-unit="60" passive="0"/>
    </operation>

    <operation name="mix-in-steps" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="wash" station="counter" tedium="1">
        <title>Mix in steps</title>
        <options>
            <option name="task-size" type="numeric" required="false" default-unit="deciliters"/>
        </options>
        <timeline model="per-unit" active="0" per-unit="10" passive="0"/>
    </operation>

    <operation name="beat" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="wash" station="counter" tedium="1">
        <title>Beat</title>
        <timeline model="per-unit" active="0" per-unit="60" passive="0"/>
    </operation>

    <operation name="whip" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="wash" station="counter" tedium="1">
        <title>Whip</title>
        <timeline model="per-unit" active="0" per-unit="300" passive="0"/>
    </operation>

    <operation name="cream" min-inputs="2" min-outputs="1" requires-tools="true"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="wash" station="counter" tedium="1">
        <title>Cream</title>
        <timeline model="per-unit" active="0" per-unit="120" passive="0"/>
    </operation>

    <operation name="fold" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="wash" station="counter" tedium="1">
        <title>Fold</title>
        <timeline model="sub-linear" active="0" per-unit="120" passive="0"/>
    </operation>

    <operation name="stir" min-inputs="1" max-inputs="1" min-outputs="1" requires-tools="true"
               attention="attended" divisible="units" min-chunk="180" preemptible="anywhere" resume-cost="20" soil="rinse" station="bar" tedium="1">
        <title>Stir</title>
        <timeline model="per-unit" active="20" per-unit="5" passive="0"/>
    </operation>

    <operation name="muddle" min-inputs="1" min-outputs="1" requires-tools="true"
               attention="attended" divisible="units" min-chunk="180" preemptible="units" soil="rinse" station="bar" tedium="1">
        <title>Muddle</title>
        <timeline model="per-unit" active="0" per-unit="30" passive="0"/>
    </operation>

    <!-- ===== Heat ===== -->

    <operation name="heat" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="unattended" divisible="none" preemptible="never" soil="rinse" station="hob" tedium="1" requires="hot-pan">
        <title>Heat</title>
        <options>
            <option name="temperature" type="numeric" required="false" default-unit="celsius"/>
            <option name="duration" type="numeric" required="false" default-unit="seconds"/>
        </options>
        <timeline model="fixed" active="30" passive="0" passive-from="formula:heat"/>
        <completion urgency="timed" early="0" late="300" duration="30"/>
    </operation>

    <operation name="soften" min-inputs="1" max-inputs="1" min-outputs="1" requires-tools="true"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="rinse" station="hob" tedium="1" requires="hot-pan">
        <title>Soften</title>
        <timeline model="sub-linear" active="0" per-unit="120" passive="0"/>
    </operation>

    <operation name="melt" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="monitored" check-interval="120" check-duration="10" divisible="none" preemptible="never"
               soil="rinse" station="hob" tedium="1" requires="hot-pan">
        <title>Melt</title>
        <timeline model="sub-linear" active="0" per-unit="30" passive="60"/>
        <completion urgency="critical" early="0" late="60" duration="30"/>
    </operation>

    <operation name="boil" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="monitored" check-interval="120" check-duration="10" divisible="none" preemptible="never"
               soil="rinse" station="hob" tedium="1" requires="hot-pan">
        <title>Boil</title>
        <options>
            <option name="duration" type="numeric" required="false" default-unit="minutes"/>
        </options>
        <timeline model="sub-linear" active="0" per-unit="30" passive="200" passive-from="duration"/>
        <completion urgency="critical" early="0" late="60" duration="30"/>
    </operation>

    <operation name="preheat-oven" min-inputs="0" max-inputs="0" min-outputs="1" max-outputs="1"
               attention="unattended" divisible="none" preemptible="never" soil="none" station="oven" tedium="1" requires="oven">
        <title>Preheat the oven</title>
        <options>
            <option name="temperature" type="numeric" required="true" default-unit="celsius"/>
        </options>
        <timeline model="fixed" active="30" passive="0" passive-from="formula:preheat"/>
        <completion urgency="relaxed" early="0" late="300" duration="30"/>
    </operation>

    <operation name="bake-in-oven" min-inputs="1" max-inputs="1" min-outputs="1" max-outputs="1"
               attention="unattended" divisible="none" preemptible="never" soil="none" station="oven" tedium="1" requires="oven"
               expand="bake-in-oven">
        <title>Bake</title>
        <options>
            <option name="temperature" type="numeric" required="true" default-unit="celsius"/>
            <option name="duration" type="numeric" required="true" default-unit="minutes"/>
        </options>
        <timeline model="fixed" active="30" passive="0" passive-from="duration"/>
        <completion urgency="critical" early="0" late="60" duration="30"/>
    </operation>

    <operation name="put-into-oven" min-inputs="1" min-outputs="1"
               attention="unattended" divisible="none" preemptible="never" soil="none" station="oven" tedium="1" requires="oven">
        <title>Put into oven</title>
        <options>
            <option name="duration" type="numeric" required="true" default-unit="minutes"/>
        </options>
        <timeline model="fixed" active="30" passive="0" passive-from="duration"/>
        <completion urgency="critical" early="0" late="60" duration="30"/>
    </operation>

    <operation name="take-out-of-oven" min-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="none" station="oven" tedium="1" requires="oven">
        <title>Take out of oven</title>
        <timeline model="fixed" active="30" passive="0"/>
    </operation>

    <operation name="bake-in-microwave" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="unattended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1">
        <title>Bake</title>
        <options>
            <option name="power" type="numeric" required="false" default-unit="watts"/>
            <option name="duration" type="numeric" required="true" default-unit="seconds"/>
        </options>
        <timeline model="fixed" active="30" passive="0" passive-from="duration"/>
        <completion urgency="critical" early="0" late="60" duration="30"/>
    </operation>

    <!-- ===== Waiting ===== -->

    <operation name="wait" min-inputs="0" max-inputs="0" min-outputs="0" max-outputs="0"
               attention="unattended" divisible="none" preemptible="never" soil="none" station="counter" tedium="1">
        <title>Wait</title>
        <options>
            <option name="duration" type="numeric" required="true" default-unit="seconds"/>
        </options>
        <timeline model="fixed" active="0" passive="0" passive-from="duration"/>
        <completion urgency="relaxed" early="0" late="300" duration="30"/>
    </operation>

    <operation name="raise" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="unattended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1">
        <title>Raise</title>
        <options>
            <option name="duration" type="numeric" required="true" default-unit="seconds"/>
            <option name="multiplier" type="numeric" required="false" default-unit="percent"/>
            <option name="temperature" type="numeric" required="false" default-unit="celsius"/>
        </options>
        <timeline model="fixed" active="60" passive="0" passive-from="duration"/>
        <completion urgency="timed" early="0" late="300" duration="30"/>
    </operation>

    <operation name="chill" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="unattended" divisible="none" preemptible="never" soil="rinse" station="fridge" tedium="1">
        <title>Chill</title>
        <options>
            <option name="duration" type="numeric" required="true" default-unit="hours"/>
        </options>
        <timeline model="sub-linear" active="0" per-unit="30" passive="0" passive-from="duration"/>
        <completion urgency="timed" early="0" late="300" duration="30"/>
    </operation>

    <operation name="soak" min-inputs="1" min-outputs="1"
               attention="unattended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1">
        <title>Soak</title>
        <options>
            <option name="duration" type="numeric" required="false" default-unit="seconds"/>
        </options>
        <timeline model="sub-linear" active="0" per-unit="60" passive="120" passive-from="duration"/>
        <completion urgency="timed" early="0" late="300" duration="30"/>
    </operation>

    <!-- ===== Shaping and assembly ===== -->

    <operation name="spherify" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="units" min-chunk="180" preemptible="units" soil="rinse" station="counter" tedium="1">
        <title>Roll into balls</title>
        <timeline model="per-unit" active="0" per-unit="15" passive="0"/>
    </operation>

    <operation name="ball" min-inputs="1" max-inputs="1" min-outputs="1" requires-tools="true"
               attention="attended" divisible="units" min-chunk="180" preemptible="units" soil="rinse" station="counter" tedium="1">
        <title>Ball</title>
        <timeline model="per-unit" active="30" per-unit="20" passive="0"/>
    </operation>

    <operation name="place-on-sheet" min-inputs="1" max-inputs="2" min-outputs="1"
               attention="attended" divisible="units" min-chunk="180" preemptible="units" soil="rinse" station="counter" tedium="1">
        <title>Place on sheet</title>
        <timeline model="per-unit" active="0" per-unit="5" passive="0"/>
    </operation>

    <operation name="place" min-inputs="1" max-inputs="2" min-outputs="1"
               attention="attended" divisible="units" min-chunk="180" preemptible="units" soil="rinse" station="counter" tedium="1">
        <title>Place</title>
        <timeline model="per-unit" active="20" per-unit="5" passive="0"/>
    </operation>

    <operation name="brush" min-inputs="2" min-outputs="1"
               attention="attended" divisible="units" min-chunk="180" preemptible="units" soil="wash" station="counter" tedium="1">
        <title>Brush</title>
        <timeline model="per-unit" active="0" per-unit="5" passive="0"/>
    </operation>

    <operation name="sprinkle" min-inputs="2" min-outputs="1"
               attention="attended" divisible="units" min-chunk="180" preemptible="units" soil="rinse" station="counter" tedium="1">
        <title>Sprinkle</title>
        <timeline model="per-unit" active="0" per-unit="5" passive="0"/>
    </operation>

    <operation name="dust" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1">
        <title>Dust</title>
        <timeline model="sub-linear" active="0" per-unit="60" passive="0"/>
    </operation>

    <operation name="grease" min-inputs="1" max-inputs="1" min-outputs="1" requires-tools="true"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="rinse" station="counter" tedium="1">
        <title>Grease</title>
        <timeline model="per-unit" active="90" per-unit="5" passive="0"/>
    </operation>

    <operation name="line" min-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="none" station="counter" tedium="1">
        <title>Line</title>
        <timeline model="per-unit" active="30" per-unit="40" passive="0"/>
    </operation>

    <operation name="pour" min-inputs="1" max-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1">
        <title>Pour</title>
        <timeline model="per-unit" active="20" per-unit="8" passive="0"/>
    </operation>

    <operation name="transfer" min-inputs="1" min-outputs="1" requires-tools="true"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1">
        <title>Transfer</title>
        <timeline model="per-unit" active="60" per-unit="2" passive="0"/>
    </operation>

    <operation name="spread" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="rinse" station="counter" tedium="1">
        <title>Spread</title>
        <timeline model="sub-linear" active="0" per-unit="360" passive="0"/>
    </operation>

    <operation name="spoon" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1">
        <title>Spoon</title>
        <timeline model="sub-linear" active="0" per-unit="60" passive="0"/>
    </operation>

    <operation name="cover" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="none" station="counter" tedium="1">
        <title>Cover</title>
        <timeline model="per-unit" active="45" per-unit="2" passive="0"/>
    </operation>

    <operation name="level" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="rinse" station="counter" tedium="1">
        <title>Level</title>
        <timeline model="sub-linear" active="0" per-unit="120" passive="0"/>
    </operation>

    <operation name="add-on-top" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="rinse" station="counter" tedium="1">
        <title>Add on top</title>
        <timeline model="sub-linear" active="0" per-unit="120" passive="0"/>
    </operation>

    <operation name="press" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="anywhere" resume-cost="20" soil="rinse" station="counter" tedium="1">
        <title>Press</title>
        <timeline model="sub-linear" active="0" per-unit="120" passive="0"/>
    </operation>

    <operation name="stack" min-inputs="2" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="counter" tedium="1">
        <title>Stack</title>
        <timeline model="per-unit" active="30" per-unit="5" passive="0"/>
    </operation>

    <operation name="decorate" min-inputs="2" min-outputs="1"
               attention="attended" divisible="team" max-people="2" speedup="1.6" preemptible="anywhere" resume-cost="20"
               soil="rinse" station="counter" tedium="1">
        <title>Decorate</title>
        <timeline model="per-unit" active="0" per-unit="180" passive="0"/>
    </operation>

    <!-- ===== Bar ===== -->

    <operation name="fill" min-inputs="1" max-inputs="1" min-outputs="1"
               attention="attended" divisible="units" min-chunk="180" preemptible="anywhere" resume-cost="20" soil="rinse" station="bar" tedium="1">
        <title>Fill</title>
        <timeline model="per-unit" active="30" per-unit="10" passive="0"/>
    </operation>

    <operation name="strain" min-inputs="1" max-inputs="2" min-outputs="1" requires-tools="true"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="bar" tedium="1">
        <title>Strain</title>
        <timeline model="per-unit" active="20" per-unit="10" passive="0"/>
    </operation>

    <operation name="express" min-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="rinse" station="bar" tedium="1">
        <title>Express</title>
        <timeline model="per-unit" active="0" per-unit="30" passive="0"/>
    </operation>

    <!-- ===== Structure, serving and housekeeping ===== -->

    <operation name="batch" min-inputs="1" min-outputs="1"
               attention="attended" divisible="none" preemptible="never" soil="none" station="counter" tedium="1">
        <title>Process in batches</title>
        <timeline model="per-unit" active="0" per-unit="60" passive="0"/>
    </operation>

    <operation name="enjoy" min-inputs="1" max-inputs="1" min-outputs="0" max-outputs="0"
               attention="attended" divisible="none" preemptible="never" soil="none" station="counter" tedium="1">
        <title>Enjoy</title>
        <timeline model="fixed" active="180" passive="0"/>
    </operation>

    <operation name="serve" min-inputs="1" min-outputs="0" max-outputs="0"
               attention="attended" divisible="none" preemptible="never" soil="none" station="counter" tedium="1">
        <title>Serve</title>
        <timeline model="fixed" active="0" passive="0"/>
    </operation>

    <operation name="clean" min-inputs="0" max-inputs="0" min-outputs="0" max-outputs="0"
               attention="attended" divisible="none" preemptible="never" soil="none" station="sink" tedium="1.5">
        <title>Wash up</title>
        <timeline model="fixed" active="60" passive="0"/>
    </operation>

</operations>
