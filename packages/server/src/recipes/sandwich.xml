<?xml version="1.0" encoding="utf-8" ?>
<recipe xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="recipe.xsd"
        version="2" id="sandwich">
    <title>Simple Butter Sandwich</title>
    <serving temperature="ambient"/>
    <ingredients>
        <ingredient id="bread">bread</ingredient>
        <ingredient id="butter">butter</ingredient>
        <ingredient id="cucumber">cucumber</ingredient>
        <ingredient id="tomato">tomato</ingredient>
    </ingredients>
    <tools>
        <tool id="knife">knife</tool>
        <tool id="plate">plate<properties>
                <property name="capacity">
                    <numeric-value number="1" unit="sandwich"/>
                </property>
            </properties>
        </tool>
    </tools>
    <tasks>
        <task operation="split" id="slice-bread" requires="knife">
            <options>
                <option name="parts">
                    <numeric-value number="2"/>
                </option>
            </options>
            <inputs>
                <input ref="bread"/>
            </inputs>
            <tools>
                <tool ref="knife" soil="none"/>
            </tools>
            <outputs>
                <output id="bread-slice" amount="2" unit="slice">bread slice</output>
            </outputs>
        </task>
        <task operation="spread" id="butter-bread">
            <inputs>
                <input ref="butter"/>
                <input ref="bread-slice"/>
            </inputs>
            <tools>
                <tool ref="knife" soil="rinse"/>
            </tools>
            <outputs>
                <output id="buttered-slice" amount="2" unit="slice">buttered bread slice</output>
            </outputs>
        </task>
        <task operation="slice" id="slice-cucumber" requires="knife">
            <options>
                <option name="parts">
                    <numeric-value number="6"/>
                </option>
            </options>
            <inputs>
                <input ref="cucumber"/>
            </inputs>
            <tools>
                <tool ref="knife" soil="none"/>
            </tools>
            <outputs>
                <output id="cucumber-slices">cucumber slices</output>
            </outputs>
        </task>
        <task operation="slice" id="slice-tomato" requires="knife">
            <options>
                <option name="parts">
                    <numeric-value number="10"/>
                </option>
            </options>
            <inputs>
                <input ref="tomato"/>
            </inputs>
            <tools>
                <tool ref="knife" soil="rinse"/>
            </tools>
            <outputs>
                <output id="tomato-slices" hold="30" hold-unit="minutes">tomato slices</output>
            </outputs>
        </task>
        <task operation="place" id="place-base-on-plate">
            <instructions>
                Place one
                <input ref="buttered-slice"/>
                on a
                <tool ref="plate" reserved="true"/>
            </instructions>
            <outputs>
                <output id="sandwich-base" amount="1" unit="sandwich">sandwich base</output>
            </outputs>
        </task>
        <task operation="add-on-top" id="add-cucumber">
            <instructions>
                Add the
                <input ref="cucumber-slices"/>
                on top of the
                <input ref="sandwich-base"/>
            </instructions>
            <outputs>
                <output id="sandwich-with-cucumber" amount="1" unit="sandwich">sandwich with cucumber</output>
            </outputs>
        </task>
        <task operation="add-on-top" id="add-tomato">
            <inputs>
                <input ref="sandwich-with-cucumber"/>
                <input ref="tomato-slices"/>
            </inputs>
            <outputs>
                <output id="sandwich-with-tomato" amount="1" unit="sandwich">butter sandwich with cucumber and tomato</output>
            </outputs>
        </task>
        <task operation="stack" id="close-sandwich">
            <inputs>
                <input ref="sandwich-with-tomato"/>
                <input ref="buttered-slice"/>
            </inputs>
            <outputs>
                <output id="finished-sandwich" amount="1" unit="sandwich" final="true">sandwich with cucumber and tomato</output>
            </outputs>
            <instructions>
                Close the <input ref="sandwich-with-tomato"/> with the second <input ref="buttered-slice"/>, buttered side down.
            </instructions>
        </task>
    </tasks>
</recipe>
